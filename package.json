{
  "name": "lamha-website",
  "version": "0.1.0",
  "private": true,
  "description": "LAMHA Technologies (LAMHA TECHNOLOGIES (PRIVATE) LIMITED) \u2014 corporate website",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/prebuild.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "seo:indexnow": "node scripts/indexnow.mjs",
    "admin:recovery": "node scripts/admin-recovery.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@vercel/blob": "^2.8.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.0.0",
    "motion": "^13.4.4",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.60.0",
    "resend": "^6.30.0",
    "three": "^0.186.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.11"
  }
}
